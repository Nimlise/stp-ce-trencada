# game/scripts/special/felina/felina_fight_1.rpy:1845
translate catalan felina_nightmare_start_fd75a07c:

    # voice "audio/voices/felina/fight/nm1a.flac"
    # mounds "Fear is what pretends to protect us from loss. To fear death 'protects' from losing a body. To fear ruin 'protects' from losing status. To fear rejection 'protects' from being known.\n"
    voice "audio/voices/felina/fight/nm1a.flac"
    mounds ""

# game/scripts/special/felina/felina_fight_1.rpy:1847
translate catalan felina_nightmare_start_aa6638dc:

    # voice "audio/voices/felina/fight/nm2.flac"
    voice "audio/voices/felina/fight/nm2.flac"

# game/scripts/special/felina/felina_fight_1.rpy:1859
translate catalan felina_nightmare_start_a366b085:

    # mound "But losing a body is contained within having a body. Losing status is contained within having status. Being known is contained within being conscious.\n"
    mound ""

# game/scripts/special/felina/felina_fight_1.rpy:1860
translate catalan felina_nightmare_start_823bb40f:

    # voice "audio/voices/felina/fight/nm3.flac"
    voice "audio/voices/felina/fight/nm3.flac"

# game/scripts/special/felina/felina_fight_1.rpy:1864
translate catalan felina_nightmare_start_1b5d79ff:

    # mound "It is the nature of all things to transform. To go from known to hidden to known again.\n"
    mound ""

# game/scripts/special/felina/felina_fight_1.rpy:1865
translate catalan felina_nightmare_start_77e180c3:

    # voice "audio/voices/felina/fight/nm4.flac"
    voice "audio/voices/felina/fight/nm4.flac"

# game/scripts/special/felina/felina_fight_1.rpy:1869
translate catalan felina_nightmare_start_7094dafc:

    # mound "But when the ceaseless impermanence of all things strips away the finality of endings, what remains of fear? Is it a shelter protecting you from itself? Or is it a shelter protecting itself from you?\n"
    mound ""

# game/scripts/special/felina/felina_fight_1.rpy:1870
translate catalan felina_nightmare_start_0c60a71f:

    # voice "audio/voices/felina/fight/nm5.flac"
    voice "audio/voices/felina/fight/nm5.flac"

# game/scripts/special/felina/felina_fight_1.rpy:1874
translate catalan felina_nightmare_start_96c96519:

    # mound "You took fear by the hand and walked with it into the unknown, and through that, you feared nothing.\n"
    mound ""

# game/scripts/special/felina/felina_fight_1.rpy:1878
