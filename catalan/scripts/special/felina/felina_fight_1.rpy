    # voice "audio/_pristine/voice/_climax/felina/65.flac"
    voice "audio/_pristine/voice/_climax/felina/65.flac"

# game/scripts/special/felina/felina_fight_1.rpy:2312
translate catalan felina_prisoner_start_3cf35ae3:

    # mound "Bound for eternity, you saw the need for impermanence, and it was through that need that you carved our freedom.\n"
    mound ""

# game/scripts/special/felina/felina_fight_1.rpy:2315
translate catalan felina_prisoner_start_0bc60ec7:

    # voice "audio/_pristine/voice/_climax/felina/66.flac"
    voice "audio/_pristine/voice/_climax/felina/66.flac"

# game/scripts/special/felina/felina_fight_1.rpy:2319
translate catalan felina_prisoner_start_87bd35aa:

    # mound "Without impermanence the suffering of living things is infinite.\n"
    mound ""

# game/scripts/special/felina/felina_fight_1.rpy:2322
