    # voice "audio/_pristine/voice/_climax/felina/68.flac"
    voice "audio/_pristine/voice/_climax/felina/68.flac"

# game/scripts/special/felina/felina_fight_1.rpy:2545
translate catalan felina_razor_start_4a92a944:

    # mound "You learned to put yourself away. And in your stillness you rose above me.\n"
    mound ""

# game/scripts/special/felina/felina_fight_1.rpy:2549
translate catalan felina_razor_start_60a70315:

    # voice "audio/_pristine/voice/_climax/felina/69.flac"
    voice "audio/_pristine/voice/_climax/felina/69.flac"

# game/scripts/special/felina/felina_fight_1.rpy:2554
translate catalan felina_razor_start_dc9e7d68:

    # mound "You learned to put yourself away. And in your stillness you humbled me.\n"
    mound ""

# game/scripts/special/felina/felina_fight_1.rpy:2556
translate catalan felina_razor_start_778cf50a:

    # voice "audio/_pristine/voice/_climax/felina/70.flac"
    voice "audio/_pristine/voice/_climax/felina/70.flac"

# game/scripts/special/felina/felina_fight_1.rpy:2560
translate catalan felina_razor_start_8a3d33b8:

    # mound "You died countless steely deaths, and you lived countless short lives, and yet it is all so far behind you. I pushed you to a greatness you never would have reached without me.\n"
    mound ""

# game/scripts/special/felina/felina_fight_1.rpy:2565
translate catalan felina_razor_menu_11fdb519:

    # extend "" nointeract
    extend "" nointeract

# game/scripts/special/felina/felina_fight_1.rpy:2575
translate catalan felina_razor_menu_11fdb519_1:

    # extend "" nointeract
    extend "" nointeract

# game/scripts/special/felina/felina_fight_1.rpy:2578
