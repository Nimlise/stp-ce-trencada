    voice "audio/voices/felina/fight/nm6.flac"

# game/scripts/special/felina/felina_fight_1.rpy:1891
translate catalan felina_nightmare_menu_c6a7fc0b:

    # mound "Were you afraid when you stepped through that door, or were you enticed by what might come next? By what might lie beyond fear? By what you might become?\n"
    mound ""

# game/scripts/special/felina/felina_fight_1.rpy:1892
translate catalan felina_nightmare_menu_977fb04f:

    # voice "audio/voices/felina/fight/nm7.flac"
    voice "audio/voices/felina/fight/nm7.flac"

# game/scripts/special/felina/felina_fight_1.rpy:1895
translate catalan felina_nightmare_menu_01f72de2:

    # mound "You say I broke you, but was that curiosity not freedom of its own?\n"
    mound ""

# game/scripts/special/felina/felina_fight_1.rpy:1900
translate catalan felina_nightmare_menu_b3b08226:

    # voice "audio/voices/felina/fight/nm8.flac"
    voice "audio/voices/felina/fight/nm8.flac"

# game/scripts/special/felina/felina_fight_1.rpy:1904
translate catalan felina_nightmare_menu_f9f6fdeb:

    # mound "A desire borne from the narrow view of a single life. But even then, the only gifts I brought were context and sensation.\n"
    mound ""

# game/scripts/special/felina/felina_fight_1.rpy:1905
translate catalan felina_nightmare_menu_1ecc6d0c:

    # voice "audio/voices/felina/fight/nm9.flac"
    voice "audio/voices/felina/fight/nm9.flac"

# game/scripts/special/felina/felina_fight_1.rpy:1908
translate catalan felina_nightmare_menu_d10b0a0c:

    # mound "To feel is to exist, and to exist is to have meaning.\n"
    mound ""

# game/scripts/special/felina/felina_fight_1.rpy:1912
translate catalan felina_nightmare_menu_78fd79b0:

    # voice "audio/voices/felina/fight/nm10.flac"
    voice "audio/voices/felina/fight/nm10.flac"

# game/scripts/special/felina/felina_fight_1.rpy:1916
translate catalan felina_nightmare_menu_4871bf34:

    # mound "Then you are one step closer to being free of your bindings.\n"
    mound ""

# game/scripts/special/felina/felina_fight_1.rpy:1922
translate catalan felina_nightmare_menu_e6323f74:

    # voice "audio/_pristine/voice/_climax/felina/59.flac"
    voice "audio/_pristine/voice/_climax/felina/59.flac"

# game/scripts/special/felina/felina_fight_1.rpy:1926
translate catalan felina_nightmare_menu_df32770d:

    # mound "Others cling to fear because they have not yet seen beyond it. Will you strip the world of possibility just because some refuse to see its beauty?\n"
    mound ""

# game/scripts/special/felina/felina_fight_1.rpy:2046
translate catalan felina_nightmare2_start_17d2ae9d:

    # voice "audio/voices/felina/fight/c1.flac"
    # mounds "There are few things more terrifying than one's own heart, and there is almost nothing more terrifying than sharing it with another.\n"
    voice "audio/voices/felina/fight/c1.flac"
    mounds ""

# game/scripts/special/felina/felina_fight_1.rpy:2048
translate catalan felina_nightmare2_start_57ea48c9:

    # voice "audio/voices/felina/fight/c2.flac"
    voice "audio/voices/felina/fight/c2.flac"

# game/scripts/special/felina/felina_fight_1.rpy:2060
translate catalan felina_nightmare2_start_4f46c3ed:

    # mound "But the most terrifying thing of all is to leave one's heart unshared. You are the only thing like me, and I am the only thing like you.\n"
    mound ""

# game/scripts/special/felina/felina_fight_1.rpy:2061
translate catalan felina_nightmare2_start_159752d2:

    # voice "audio/voices/felina/fight/c3.flac"
    voice "audio/voices/felina/fight/c3.flac"

# game/scripts/special/felina/felina_fight_1.rpy:2065
translate catalan felina_nightmare2_start_413a1527:

    # mound "Could you bear the weight of an eternity alone? Do you dare to shape a reality of solitude and thrust it on creation?\n"
    mound ""

