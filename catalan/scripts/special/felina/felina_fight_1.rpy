    # voice "audio/voices/felina/fight/razor6.flac"
    voice "audio/voices/felina/fight/razor6.flac"

# game/scripts/special/felina/felina_fight_1.rpy:2583
translate catalan felina_razor_menu_2e9bddc5:

    # mound "And yet here we are, finally on the cusp of reaching something so much bigger than that little play.\n"
    mound ""

# game/scripts/special/felina/felina_fight_1.rpy:2586
translate catalan felina_razor_menu_f6297ddd:

    # voice "audio/voices/felina/fight/razor7.flac"
    voice "audio/voices/felina/fight/razor7.flac"

# game/scripts/special/felina/felina_fight_1.rpy:2592
translate catalan felina_razor_menu_f80ac37c:

