    voice "audio/voices/felina/fight/p9.flac"

# game/scripts/special/felina/felina_fight_1.rpy:2346
translate catalan felina_prisoner_menu_623f6840:

    # mound "And that is what I want, too. To protect them from the horrors of an eternity without me.\n"
    mound ""

# game/scripts/special/felina/felina_fight_1.rpy:2350
translate catalan felina_prisoner_menu_74d3b417:

    # voice "audio/voices/felina/fight/p10.flac"
    voice "audio/voices/felina/fight/p10.flac"

# game/scripts/special/felina/felina_fight_1.rpy:2355
translate catalan felina_prisoner_menu_4c7bcf94:

    # mound "Nor should you. Nor should I. Our purpose is to be and to experience, and their purpose is the same.\n"
    mound ""

# game/scripts/special/felina/felina_fight_1.rpy:2359
translate catalan felina_prisoner_menu_261a7671:

    # voice "audio/voices/felina/fight/p11.flac"
    voice "audio/voices/felina/fight/p11.flac"

# game/scripts/special/felina/felina_fight_1.rpy:2364
translate catalan felina_prisoner_menu_e4f01fe8:

    # mound "The path only ends when it becomes a new beginning. To see those seams as finality is to pass over them with closed eyes.\n"
    mound ""

# game/scripts/special/felina/felina_fight_1.rpy:2369
translate catalan felina_prisoner_menu_1091bdf5:

    # voice "audio/voices/felina/fight/p12.flac"
    voice "audio/voices/felina/fight/p12.flac"

# game/scripts/special/felina/felina_fight_1.rpy:2373
translate catalan felina_prisoner_menu_8c67b6b7:

    # mound "Or, in time, would they see it as a curse?\n"
    mound ""

# game/scripts/special/felina/felina_fight_1.rpy:2377
translate catalan felina_prisoner_menu_bcf720d9:

    # voice "audio/voices/felina/fight/p13.flac"
    voice "audio/voices/felina/fight/p13.flac"

# game/scripts/special/felina/felina_fight_1.rpy:2382
translate catalan felina_prisoner_menu_de1976eb:

    # mound "It would. Our purpose is to be and to experience, and their purpose is the same. To be permanent is to cease. To be paused is to be trapped.\n"
    mound ""

# game/scripts/special/felina/felina_fight_1.rpy:2523
translate catalan felina_razor_start_2f9dc7e4:

    # voice "audio/voices/felina/fight/razor1.flac"
    # mounds "A boundless torrent of blades cuts you from boundless angles. You are a body. You are gory ribbons. You are a body again. And you feel all of it.\n"
    voice "audio/voices/felina/fight/razor1.flac"
    mounds ""

# game/scripts/special/felina/felina_fight_1.rpy:2525
translate catalan felina_razor_start_aa97d2ee:

    # voice "audio/voices/felina/fight/razor2.flac"
    voice "audio/voices/felina/fight/razor2.flac"

# game/scripts/special/felina/felina_fight_1.rpy:2537
translate catalan felina_razor_start_39e08bf7:

    # mounds "On and on it goes, until your bodies are not your thoughts are not you. Alive, dead, alive, dead, alive, dead, then alive and dead and alive and dead all at once.\n"
    mounds ""

# game/scripts/special/felina/felina_fight_1.rpy:2541
