translate catalan strings:

    # game/scripts/special/felina/felina_fight_0_staging.rpy:356
    old "{i}• (Explore) ''It's easy to believe in the things you believe in when you get to sit above it all.''{/i}"
    new ""

    # game/scripts/special/felina/felina_fight_0_staging.rpy:356
    old "{i}• (Explore) ''What do you think happens if we leave here?''{/i}"
    new ""

    # game/scripts/special/felina/felina_fight_0_staging.rpy:356
    old "{i}• ''Okay. I'm ready to go. But how do we leave?''{/i}"
    new ""

    # game/scripts/special/felina/felina_fight_0_staging.rpy:356
    old "{i}• ''I never wanted to fight you. But how do we leave?''{/i}"
    new ""

    # game/scripts/special/felina/felina_fight_0_staging.rpy:356
    old "{i}• ''I can't let that happen. I can't let everything die.'' [[Slay the Princess.]{/i}"
    new ""

    # game/scripts/special/felina/felina_fight_0_staging.rpy:356
    old "{i}• ''I was told there was enough of you in me to preserve meaning in existence. I'm going to trust that's true.'' [[Slay the Princess.]{/i}"
    new ""

    # game/scripts/special/felina/felina_fight_0_staging.rpy:356
    old "{i}• ''I have to fight for a better world. I'm so sorry.'' [[Slay the Princess.]{/i}"
    new ""

    # game/scripts/special/felina/felina_fight_0_staging.rpy:356
    old "{i}• ''You are cruelty itself, and I cannot let you exist.'' [[Slay the Princess.]{/i}"
    new ""

    # game/scripts/special/felina/felina_fight_0_staging.rpy:356
    old "{i}• ''I don't know what the answer is, but there has to be something else. It can't be {b}this{/b}. I won't kill you, but I won't let you free.''{/i}"
    new ""

    # game/scripts/special/felina/felina_fight_0_staging.rpy:356
    old "{i}• ''You've done everything you can to make me understand your perspective, but you keep dismissing mine. If you think you can change me, then I must be able to change you.''{/i}"
    new ""

    # game/scripts/special/felina/felina_fight_0_staging.rpy:453
    old "{i}• (Explore) ''Which... 'Hero' are you?''{/i}"
    new ""

    # game/scripts/special/felina/felina_fight_0_staging.rpy:453
    old "{i}• ''You have no idea how good it is to hear you.''{/i}"
    new ""

    # game/scripts/special/felina/felina_fight_0_staging.rpy:453
    old "{i}• ''I can do this alone.''{/i}"
    new ""

    # game/scripts/special/felina/felina_fight_0_staging.rpy:453
    old "{i}• ''Where's everyone else?''{/i}"
    new ""

    # game/scripts/special/felina/felina_fight_0_staging.rpy:453
    old "{i}• ''How are you supposed to help?''{/i}"
    new ""

    # game/scripts/special/felina/felina_fight_0_staging.rpy:453
    old "{i}• ''I thought voices weren't allowed here.''{/i}"
    new ""

    # game/scripts/special/felina/felina_fight_0_staging.rpy:453
    old "{i}• ''I thought you died whenever I looked in the mirror.''{/i}"
    new ""

    # game/scripts/special/felina/felina_fight_0_staging.rpy:550
    old "{i}• ''I'm ready.''{/i}"
    new ""

    # game/scripts/special/felina/felina_fight_0_staging.rpy:550
    old "{i}• ''I can do this out here on my own.''{/i}"
    new ""

