translate catalan strings:

    # game/scripts/special/felina/felina_cabin_gentle.rpy:84
    old "{i}• (Explore) ''It's so good to finally see you again.''{/i}"
    new ""

    # game/scripts/special/felina/felina_cabin_gentle.rpy:84
    old "{i}• (Explore) ''I'm sorry for all of the times I've hurt you.''{/i}"
    new ""

    # game/scripts/special/felina/felina_cabin_gentle.rpy:84
    old "{i}• (Explore) ''I don't think I want to be a god.''{/i}"
    new ""

    # game/scripts/special/felina/felina_cabin_gentle.rpy:84
    old "{i}• (Explore) ''Are you... the same as you are out there?''{/i}"
    new ""

    # game/scripts/special/felina/felina_cabin_gentle.rpy:84
    old "{i}• (Explore) ''Which... Princess are you? You look like you did the first time we met. Is this the real you?''{/i}"
    new ""

    # game/scripts/special/felina/felina_cabin_gentle.rpy:84
    old "{i}• (Explore) ''So, now that we're here at the end of everything... can you finally tell me your name?''{/i}"
    new ""

    # game/scripts/special/felina/felina_cabin_gentle.rpy:84
    old "{i}• (Explore) ''None of this was ever really fair for either of us, was it?''{/i}"
    new ""

    # game/scripts/special/felina/felina_cabin_gentle.rpy:84
    old "{i}• (Explore) ''I only wanted to slay the you out there. It's easier to want to kill an abstract concept than it is a person.''{/i}"
    new ""

    # game/scripts/special/felina/felina_cabin_gentle.rpy:84
    old "{i}• (Explore) ''I don't think I ever really wanted to slay you. But I don't like what your existence means for the world.''{/i}"
    new ""

    # game/scripts/special/felina/felina_cabin_gentle.rpy:84
    old "{i}• (Explore) ''What do you think of Her? What She wanted us to be.''{/i}"
    new ""

    # game/scripts/special/felina/felina_cabin_gentle.rpy:84
    old "{i}• ''What if we just leave?''{/i}"
    new ""

    # game/scripts/special/felina/felina_cabin_gentle.rpy:84
    old "{i}• ''I think the only thing left for us to do is leave.''{/i}"
    new ""

    # game/scripts/special/felina/felina_cabin_gentle.rpy:201
    old "{i}• ''I'm fine with 'The Long Quiet.'''{/i}"
    new ""

    # game/scripts/special/felina/felina_cabin_gentle.rpy:201
    old "{i}• ''I don't think I have one either.''{/i}"
    new ""

    # game/scripts/special/felina/felina_cabin_gentle.rpy:201
    old "{i}• [[Shrug.]{/i}"
    new ""

    # game/scripts/special/felina/felina_cabin_gentle.rpy:297
    old "{i}• (Explore) [[Take her hand in yours.]{/i}"
    new ""

    # game/scripts/special/felina/felina_cabin_gentle.rpy:297
    old "{i}• ''I've always wanted to leave with you, but I didn't like being a god. I want to walk through that cabin door as we are. Just you and me.''{/i}"
    new ""

    # game/scripts/special/felina/felina_cabin_gentle.rpy:297
    old "{i}• ''Not knowing what it means is why I want it. We knew everything out there, but we don't know this. I want to know something new.''{/i}"
    new ""

    # game/scripts/special/felina/felina_cabin_gentle.rpy:297
    old "{i}• ''It doesn't matter what it means. What matters is that we're leaving together. That's all I want.''{/i}"
    new ""

    # game/scripts/special/felina/felina_cabin_gentle.rpy:297
    old "{i}• ''I don't know where we'd go, but as long as it's not here, and as long as I'm with you, that's all I want.''{/i}"
    new ""

    # game/scripts/special/felina/felina_cabin_gentle.rpy:297
    old "{i}• [[There's no need for words. Leave with her.]{/i}"
    new ""

    # game/scripts/special/felina/felina_cabin_gentle.rpy:396
    old "{i}• (Explore) ''I don't want to be a god.''{/i}"
    new ""

    # game/scripts/special/felina/felina_cabin_gentle.rpy:396
    old "{i}• (Explore) ''I don't want to hurt anyone. There has to be a way out of this.''{/i}"
    new ""

    # game/scripts/special/felina/felina_cabin_gentle.rpy:396
    old "{i}• (Explore) ''What are we going to do?''{/i}"
    new ""

    # game/scripts/special/felina/felina_cabin_gentle.rpy:396
    old "{i}• (Explore) ''I don't want to have to slay you, but I don't know what other options there are.''{/i}"
    new ""

    # game/scripts/special/felina/felina_cabin_gentle.rpy:396
    old "{i}• ''I'm sorry.'' [[Slay the Princess.]{/i}"
    new ""

    # game/scripts/special/felina/felina_cabin_gentle.rpy:495
    old "{i}• (Explore) ''Would resetting it do anything to help {b}them{/b}? The people out there? If you continue to exist, then don't they continue to die and suffer?''{/i}"
    new ""

    # game/scripts/special/felina/felina_cabin_gentle.rpy:495
    old "{i}• (Explore) ''I don't want to forget you.''{/i}"
    new ""

    # game/scripts/special/felina/felina_cabin_gentle.rpy:495
    old "{i}• (Explore) ''We're going to find ourselves back here eventually.''{/i}"
    new ""

    # game/scripts/special/felina/felina_cabin_gentle.rpy:495
    old "{i}• (Explore) ''If we're talking about this right now, how do we know we haven't done this before?''{/i}"
    new ""

    # game/scripts/special/felina/felina_cabin_gentle.rpy:495
    old "{i}• (Explore) ''How do you know that things won't end worse? What if when I make my way back here I'm different and I hurt you? What if I kill you? What if I let you bring about the end of everything?''{/i}"
    new ""

    # game/scripts/special/felina/felina_cabin_gentle.rpy:495
    old "{i}• (Explore) ''But how do you know that? We'd have to decide to do this every single time. Forever. Eventually something is going to be different.''{/i}"
    new ""

    # game/scripts/special/felina/felina_cabin_gentle.rpy:495
    old "{i}• (Explore) ''This isn't fair. I want to be here with you. I don't want to be alone again.''{/i}"
    new ""

    # game/scripts/special/felina/felina_cabin_gentle.rpy:495
    old "{i}• (Explore) ''Is there any other way?''{/i}"
    new ""

    # game/scripts/special/felina/felina_cabin_gentle.rpy:495
    old "{i}• (Explore) ''I take it all back. I don't want this, and I don't want to kill you. Is it too late to go back to being a god?''{/i}"
    new ""

    # game/scripts/special/felina/felina_cabin_gentle.rpy:495
    old "{i}• ''Okay. Then let's do it. I believe in us.'' [[Agree to her plan.]{/i}"
    new ""

    # game/scripts/special/felina/felina_cabin_gentle.rpy:495
    old "{i}• ''I'm sorry, but I can't do that.'' [[Slay the Princess.]{/i}"
    new ""

    # game/scripts/special/felina/felina_cabin_gentle.rpy:606
    old "{i}• ''I love you.''{/i}"
    new ""

    # game/scripts/special/felina/felina_cabin_gentle.rpy:606
    old "{i}• ''Just do it.''{/i}"
    new ""

    # game/scripts/special/felina/felina_cabin_gentle.rpy:606
    old "{i}• ''I'll see you soon.''{/i}"
    new ""

