# game/scripts/ch_1/script.rpy:1555
translate catalan start_992051e7:

    # n "You're here to slay her. If you don't, it will be the end of the world.{fast}\n"
    n "Ets aquí per donar-li mort. Si no ho fas, serà la fi del món.{fast}\n"

# game/scripts/ch_1/script.rpy:1588
translate catalan forest_dialogue_11fdb519:

    # extend "" nointeract
    extend "" nointeract

# game/scripts/ch_1/script.rpy:1592
translate catalan forest_dialogue_650a6ab5:

    # voice "audio/voices/ch1/woods/narrator/script_n_3.flac"
    # n "I'm talking about the end of everything as we know it. No more birds, no more trees, and, perhaps most problematically of all, no more people. You have to put an end to her.\n"
    voice "audio/voices/ch1/woods/narrator/script_n_3.flac"
    n "Parlo de la fi de tot tal com ho coneixem. Ja no hi haurà ni ocells, ni arbres, ni, potser la part més problemàtica, persones. Has de posar fi a la seva vida.\n"

# game/scripts/ch_1/script.rpy:1598
translate catalan forest_dialogue_71a06bae:

    # voice "audio/voices/ch1/woods/narrator/script_n_4.flac"
    # n "Don't linger on the specifics. You have a job to do here. Just get in there and do what needs to be done. We're all counting on you.\n"
    voice "audio/voices/ch1/woods/narrator/script_n_4.flac"
    n "No et preocupis pels detalls. Tens un deure a complir. Tu ves-hi i fes el que s'ha de fer. Tothom compta amb tu.\n"

# game/scripts/ch_1/script.rpy:1605
translate catalan forest_dialogue_d844d44a:

    # voice "audio/voices/ch1/woods/narrator/script_n_5.flac"
    # n "{i}She's{/i} not dangerous. She's just a princess. The danger comes if she gets out. Which she will. Unless {i}you{/i} do something about it.\n"
    voice "audio/voices/ch1/woods/narrator/script_n_5.flac"
    n "{i}Ella{/i} no és perillosa. Només és una princesa. El perill vindrà si escapa. Cosa que farà. Tret que {i}tu{/i} hi facis alguna cosa.\n"

# game/scripts/ch_1/script.rpy:1611
translate catalan forest_dialogue_c66b0fcf:

    # voice "audio/voices/ch1/woods/narrator/script_n_6.flac"
    # n "The more specifics you have, the harder it will be for you to do this very important job. She's a princess. People will listen to her, because listening to her is in their nature. And when they do, everything will come crashing down.\n"
    voice "audio/voices/ch1/woods/narrator/script_n_6.flac"
    n "Com més detalls tinguis, més difícil se't farà fer aquesta feina tan important. És una princesa. La gent l'escoltarà perquè no ho pot evitar. I un cop l'escoltin, tot se n'anirà en orris.\n"

# game/scripts/ch_1/script.rpy:1617
translate catalan forest_dialogue_3b3bca50:

    # voice "audio/voices/ch1/woods/narrator/script_n_7.flac"
    # n "Look, you're already on the path that leads to the cabin. Why would you be here if it weren't to complete a very important task? You've made it this far, you might as well reach the end of your journey.\n"
    voice "audio/voices/ch1/woods/narrator/script_n_7.flac"
    n "Mira, ja ets al camí que porta a la cabanya. Per què hi series si no fos per dur a terme una tasca molt important? Ja que has arribat fins aquí, podries acabar-la.\n"

# game/scripts/ch_1/script.rpy:1623
translate catalan forest_dialogue_27a79af6:

    # voice "audio/voices/ch1/woods/narrator/script_n_8.flac"
    # n "While I appreciate the mental exercise, we are running up against a bit of a ticking clock.\n"
    voice "audio/voices/ch1/woods/narrator/script_n_8.flac"
    n "Tot i que aprecio l'exercici mental, anem un pèl a contrarellotge.\n"

# game/scripts/ch_1/script.rpy:1625
translate catalan forest_dialogue_35b3e803:

    # voice "audio/voices/ch1/woods/narrator/script_n_9.flac"
    # n "Nevertheless, let me assure you: the Princess is locked up because she's dangerous, she is not dangerous because she's locked up.\n"
    voice "audio/voices/ch1/woods/narrator/script_n_9.flac"
    n "De totes maneres, deixa'm assegurar-te que la princesa està empresonada perquè és perillosa i no és perillosa perquè està empresonada.\n"

# game/scripts/ch_1/script.rpy:1627
translate catalan forest_dialogue_5465960a:

    # voice "audio/voices/ch1/woods/narrator/script_n_10.flac"
    # n "And before you decide to waste even more of our time by asking how I know that, let me suggest a more pragmatic lens through which to view this situation.\n"
    voice "audio/voices/ch1/woods/narrator/script_n_10.flac"
    n "Abans que decideixis fer-nos perdre encara més temps preguntant-me com ho sé això, permet-me que et suggereixi una manera més pragmàtica de veure aquesta situació.\n"

# game/scripts/ch_1/script.rpy:1629
translate catalan forest_dialogue_5eb28a79:

    # voice "audio/voices/ch1/woods/narrator/script_n_11.flac"
    # n "Causality doesn't matter here, because the end result is the same no matter what led us up to this point. If the Princess leaves the cabin, the world will end, and there is no changing that.\n"
    voice "audio/voices/ch1/woods/narrator/script_n_11.flac"
    n "La causalitat, aquí, no importa. El resultat final és el mateix sense importar el què ens hagi portat fins a aquest punt. Si la princesa surt de la cabanya, serà la fi del món, i això no es pot canviar.\n"

# game/scripts/ch_1/script.rpy:1631
translate catalan forest_dialogue_ebbf890f:

    # voice "audio/voices/ch1/woods/narrator/script_n_12.flac"
    # n "It's no use arguing semantics over a metaphorical chicken-or-egg, because the egg is hatched and it's about to ruin everything.\n"
    voice "audio/voices/ch1/woods/narrator/script_n_12.flac"
    n "No serveix de res posar-se a discutir sobre aquest què-ha-causat-què, ja que si perdem més temps, l'únic que es causarà serà la ruïna de tot.\n"

# game/scripts/ch_1/script.rpy:1633
translate catalan forest_dialogue_7ec59473:

    # voice "audio/voices/ch1/woods/narrator/script_n_13.flac"
    # n "Unless, of course, you do your job and {i}slay her{/i}.\n"
    voice "audio/voices/ch1/woods/narrator/script_n_13.flac"
    n "Tret que, òbviament, facis la teva feina i {i}li donis mort{/i}.\n"

# game/scripts/ch_1/script.rpy:1639
translate catalan forest_dialogue_b4dce339:

    # voice "audio/voices/ch1/woods/narrator/script_n_14.flac"
    # n "Does it? Are you a monarchist? Is slaying a princess that much worse than slaying a fisherman or a miller or a seamstress? \nIf anything, slaying a princess is much {i}better{/i} than slaying a seamstress. \nSeamstresses contribute something of value to society.\n"
    voice "audio/voices/ch1/woods/narrator/script_n_14.flac"
    n "Tu creus? Estàs a favor de la monarquia? Realment creus que és pitjor donar mort a una princesa abans que a un pescador, un moliner o una costurera? \nSi ens posem així, donar mort a una princesa és molt {i}millor{/i} que donar mort a una costurera. \nLes costureres almenys tenen valor en la societat.\n"

# game/scripts/ch_1/script.rpy:1646
translate catalan forest_dialogue_1dc45dd7:

    # voice "audio/voices/ch1/woods/narrator/script_n_15.flac"
    # n "Oh, if only that were the case, but I don't make the rules.\n"
    voice "audio/voices/ch1/woods/narrator/script_n_15.flac"
    n "Ah, si tan sols fos així, però no les faig pas jo, les normes.\n"

# game/scripts/ch_1/script.rpy:1648
translate catalan forest_dialogue_1bbc184c:

    # voice "audio/voices/ch1/woods/narrator/script_n_16.flac"
    # n "I have to say I'm surprised at your reluctance thus far. But unfortunately for the both of us, you're the only one who can pull this off.\n"
    voice "audio/voices/ch1/woods/narrator/script_n_16.flac"
    n "He d'admetre que em sorprèn el recel que has mostrat fins ara. Malauradament, tant per a tu com per a mi, només tu tens l'habilitat de dur a terme aquesta tasca.\n"

# game/scripts/ch_1/script.rpy:1650
translate catalan forest_dialogue_a184579b:

    # voice "audio/voices/ch1/woods/narrator/script_n_17.flac"
    # n "Like I said, I don't make the rules. No matter how much I wish I did.\n"
    voice "audio/voices/ch1/woods/narrator/script_n_17.flac"
    n "Com t'he dit, no les faig pas jo, les normes. Per més que m'agradés que fos així.\n"

# game/scripts/ch_1/script.rpy:1653
translate catalan forest_dialogue_b3e916fa:

    # voice "audio/voices/ch1/woods/narrator/script_n_18.flac"
    # n "Unfortunately, you're the only one who can pull this off. I don't make the rules. I wish I did, but I don't.\n"
    voice "audio/voices/ch1/woods/narrator/script_n_18.flac"
    n "Malauradament, només tu pots dur a terme aquesta tasca. Jo no faig pas les normes. Tant de bo fos així, però no és el cas.\n"

# game/scripts/ch_1/script.rpy:1659
translate catalan forest_dialogue_3f8f83aa:

    # voice "audio/voices/ch1/woods/narrator/script_n_19.flac"
    # n "Are you serious? No, you {i}have{/i} to do it.\n"
    voice "audio/voices/ch1/woods/narrator/script_n_19.flac"
    n "Espero que estiguis fent broma. No, ho {i}has{/i} de fer.\n"

# game/scripts/ch_1/script.rpy:1665
translate catalan forest_dialogue_8f28b5fe:

    # voice "audio/voices/ch1/woods/narrator/script_n_20.flac"
    # n "Of course I haven't. Why would I even consider that? {i}Nobody{/i} wants the world to end.\n"
    voice "audio/voices/ch1/woods/narrator/script_n_20.flac"
    n "És clar que no. Per què ho consideraria això? {i}Ningú{/i} vol que s'acabi el món.\n"

# game/scripts/ch_1/script.rpy:1667
translate catalan forest_dialogue_b3ada299:

    # voice "audio/voices/ch1/woods/narrator/script_n_21.flac"
    # n "I mean, maybe {i}some{/i} people do, like nihilists or very very evil people, but surely you're not one of those... right?\n"
    voice "audio/voices/ch1/woods/narrator/script_n_21.flac"
    n "Bé, potser {i}algunes{/i} persones sí, com la gent nihilista o la gent molt, molt dolenta. Però tu no ets pas aquest tipus de persona... oi?\n"

# game/scripts/ch_1/script.rpy:1673
translate catalan forest_dialogue_4674dfb6:

    # voice "audio/voices/ch1/woods/narrator/s1.flac"
    # n "Yes, but you'll have to slay her before you get it.\n"
    voice "audio/voices/ch1/woods/narrator/s1.flac"
    n "Sí, però li hauràs de donar mort per aconseguir-la.\n"

# game/scripts/ch_1/script.rpy:1679
translate catalan forest_dialogue_9f4e68d6:

    # voice "audio/voices/ch1/woods/narrator/s2.flac"
    # n "It's a secret, but I think you'll like it. It's a special reward, just for you. And whatever you think it might be, I can promise you it's going to be even better than your wildest imagination.\n"
    voice "audio/voices/ch1/woods/narrator/s2.flac"
    n "És un secret, però crec que t'agradarà. És una recompensa especial, només per a tu. I, et pensis el que et pensis que és, et prometo que serà encara millor del que et puguis arribar a imaginar.\n"

# game/scripts/ch_1/script.rpy:1687
translate catalan forest_dialogue_9c4302a1:

    # voice "audio/voices/ch1/woods/narrator/script_n_22.flac"
    # n "Then I guess we'll just have to see what happens. But a word of warning— if you go in prepared to hear her out, she could easily trap you in her web of lies. And the more you listen to her honeyed words, the harder it'll be to pull yourself out.\n"
    voice "audio/voices/ch1/woods/narrator/script_n_22.flac"
    n "Llavors, suposo que només ens queda veure el que passa. Però deixa'm advertir-te: si hi entres amb ganes d'escoltar-la, és capaç d'atrapar-te dins la seva teranyina de mentides. Com més escoltis les seves dolces paraules, més difícil et serà escapar-te'n d'elles.\n"

# game/scripts/ch_1/script.rpy:1689
translate catalan forest_dialogue_7deee3bf:

    # voice "audio/voices/ch1/woods/narrator/script_n_23.flac"
    # n "Then each and every one of us is doomed.\n"
    voice "audio/voices/ch1/woods/narrator/script_n_23.flac"
    n "Aleshores, tothom estarà condemnat.\n"

# game/scripts/ch_1/script.rpy:1691
translate catalan forest_dialogue_5cdd4391:

    # voice "audio/voices/ch1/woods/narrator/script_n_24.flac"
    # n "So, sure, go talk to her. See how that turns out for all of us.\n"
    voice "audio/voices/ch1/woods/narrator/script_n_24.flac"
    n "Molt bé, ves a parlar-li. A veure com acaba això per a tots nosaltres.\n"

# game/scripts/ch_1/script.rpy:1699
translate catalan start_get_this_over_with_join_e9aa8440:

    # voice "audio/voices/ch1/woods/narrator/script_n_25.flac"
    # n "Good. As long as you remain focused on your goal, it should all be smooth sailing.\n"
    voice "audio/voices/ch1/woods/narrator/script_n_25.flac"
    n "Ben fet. Mentre tinguis el cap en el teu objectiu, tot serà bufar i fer ampolles.\n"

# game/scripts/ch_1/script.rpy:1704
translate catalan start_get_this_over_with_join_986c1746:

    # voice "audio/voices/ch1/woods/narrator/script_n_26.flac"
    # n "Don't mention it. It's all part of the job.\n"
    voice "audio/voices/ch1/woods/narrator/script_n_26.flac"
    n "No és res. Forma part de la meva feina.\n"

# game/scripts/ch_1/script.rpy:1709
translate catalan start_get_this_over_with_join_f79c0a8e:

    # voice "audio/voices/ch1/woods/narrator/script_n_27.flac"
    # n "That's the spirit!\n"
    voice "audio/voices/ch1/woods/narrator/script_n_27.flac"
    n "Així m'agrada!\n"

# game/scripts/ch_1/script.rpy:1720
translate catalan turn_and_leave_join_0214c825:

    # voice "audio/voices/ch1/woods/narrator/script_n_28.flac"
    # n "Seriously? You're just going to turn around and leave? Do you even know where you're going?\n"
    voice "audio/voices/ch1/woods/narrator/script_n_28.flac"
    n "De debò? Faràs mitja volta i fugiràs cames ajudeu-me? Tens idea d'on aniràs?\n"

# game/scripts/ch_1/script.rpy:1726
translate catalan turn_and_leave_join_11fdb519:

    # extend "" nointeract
    extend "" nointeract

# game/scripts/ch_1/script.rpy:1729
translate catalan turn_and_leave_join_d7f211c3:

    # voice "audio/voices/ch1/woods/narrator/script_n_29.flac"
    # n "{i}Thank you{/i}! The whole world owes you a debt of gratitude. Really.\n"
    voice "audio/voices/ch1/woods/narrator/script_n_29.flac"
    n "{i}Gràcies{/i}! El món sencer estarà en deute per la teva valentia. De debò.\n"

# game/scripts/ch_1/script.rpy:1733
translate catalan turn_and_leave_join_2de6e064:

    # voice "audio/voices/ch1/voices/ch1_stubborn_1.flac"
    # stubborn "Oh, about {i}time{/i}. I can't believe you were about to run away.\n"
    voice "audio/voices/ch1/voices/ch1_stubborn_1.flac"
    stubborn "Oh, ja era {i}hora/i}. No em puc creure que estiguessis a punt de fugir.\n"

# game/scripts/ch_1/script.rpy:1736
translate catalan turn_and_leave_join_ca09700d:

    # voice "audio/voices/ch1/voices/ch1_hunted_1.flac"
    # hunted "If this is what you think is best, I'll keep my ears pricked. Hopefully she won't catch us off-guard as easily as she did last time...\n"
    voice "audio/voices/ch1/voices/ch1_hunted_1.flac"
    hunted "Si creus que això és el millor, pararé bé l'orella. Amb una mica de sort, no ens enxamparà amb la guàrdia baixa com l'altra vegada...\n"

# game/scripts/ch_1/script.rpy:1739
translate catalan turn_and_leave_join_7805c5e0:

    # voice "audio/voices/ch1/voices/ch1_smitten_1.flac"
    # smitten "Save. You'll go to the cabin and {i}save{/i} the Princess.\n"
    voice "audio/voices/ch1/voices/ch1_smitten_1.flac"
    smitten "Salvar-la. Aniràs a la cabanya i {i}salvaràs{/i} la princesa.\n"

# game/scripts/ch_1/script.rpy:1742
translate catalan turn_and_leave_join_bfe01128:

    # voice "audio/voices/ch1/voices/ch1_paranoid_1.flac"
    # paranoid "One little trick was all it took for you to go in there?\n"
    voice "audio/voices/ch1/voices/ch1_paranoid_1.flac"
    paranoid "Un petit truc és el que t'ha costat per entrar-hi?\n"

# game/scripts/ch_1/script.rpy:1744
translate catalan turn_and_leave_join_be7f86ee:

    # voice "audio/voices/ch1/voices/ch1_paranoid_2.flac"
    # paranoid "{i}Sigh{/i}. I guess you're the one in control aren't you? So if you want us to die again, I guess we'll die again. Good luck. To all of us.\n"
    voice "audio/voices/ch1/voices/ch1_paranoid_2.flac"
    paranoid "{i}Aix{/i}. Ja veig que tu ets qui té el control, oi? Si vols que morim un altre cop, així serà. Bona sort. Per a tots nosaltres.\n"

# game/scripts/ch_1/script.rpy:1747
translate catalan turn_and_leave_join_a6dd72dc:

    # voice "audio/voices/ch1/voices/ch1_skeptic_1.flac"
    # skeptic "Good. Going back to the cabin is the only way we can get to the bottom of things.\n"
    voice "audio/voices/ch1/voices/ch1_skeptic_1.flac"
    skeptic ""

# game/scripts/ch_1/script.rpy:1750
translate catalan turn_and_leave_join_8d31ed69:

    # voice "audio/voices/ch1/voices/ch1_flinching_1.flac"
    # flinching "No, no, {i}no{/i} what are you doing, we were so close to getting out of here!\n"
    voice "audio/voices/ch1/voices/ch1_flinching_1.flac"
    flinching ""

# game/scripts/ch_1/script.rpy:1753
translate catalan turn_and_leave_join_07076700:

    # voice "audio/voices/ch1/voices/ch1_cold_1.flac"
    # cold "Oh well, cabin it is.\n"
    voice "audio/voices/ch1/voices/ch1_cold_1.flac"
    cold ""

# game/scripts/ch_1/script.rpy:1756
