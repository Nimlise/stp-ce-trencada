translate catalan cabin_interrior_1_16c42ba9:

    # voice "audio/voices/ch1/woods/narrator/script_n_65.flac"
    # n "The interior of the cabin is almost entirely bare. The air is stale and musty and the floor and walls are painted in a fine layer of dust. The only furniture of note is a plain wooden table. Perched on that table is a pristine blade.\n"
    voice "audio/voices/ch1/woods/narrator/script_n_65.flac"
    n "L'interior de la cabanya és gairebé nu del tot. L'aire és ranci i humit, i les parets estan cobertes d'una fina capa de pols. L'únic moble destacable és una taula senzilla de fusta. Sobre la taula, hi jeu una daga pristina.\n"

# game/scripts/ch_1/script.rpy:2195
translate catalan cabin_interrior_1_d624611a:

    # voice "audio/voices/ch1/woods/narrator/script_n_66.flac"
