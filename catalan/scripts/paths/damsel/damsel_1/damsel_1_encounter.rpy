translate catalan strings:

    # game/scripts/paths/damsel/damsel_1/damsel_1_encounter.rpy:53
    old "{i}• (Explore) ''You killed me last time and it hurt a lot! Why did you do that?''{/i}"
    new ""

    # game/scripts/paths/damsel/damsel_1/damsel_1_encounter.rpy:53
    old "{i}• (Explore) ''I didn't bring a knife. Do I have to cut you out again?''{/i}"
    new ""

    # game/scripts/paths/damsel/damsel_1/damsel_1_encounter.rpy:53
    old "{i}• (Explore) ''Do I have to cut you out again? I really didn't care for that last time.''{/i}"
    new ""

    # game/scripts/paths/damsel/damsel_1/damsel_1_encounter.rpy:53
    old "{i}• (Explore) ''What happened after I died?''{/i}"
    new ""

    # game/scripts/paths/damsel/damsel_1/damsel_1_encounter.rpy:53
    old "{i}• (Explore) ''But before we started talking, did the world end? Did you end the world?''{/i}"
    new ""

    # game/scripts/paths/damsel/damsel_1/damsel_1_encounter.rpy:53
    old "{i}• (Explore) ''I have to ask... did you end the world after you killed me back there?''{/i}"
    new ""

    # game/scripts/paths/damsel/damsel_1/damsel_1_encounter.rpy:53
    old "{i}• (Explore) ''I'm sorry about what happened last time. The Narrator who sent me here to kill you took over my body. It was extremely unfair.''{/i}"
    new ""

    # game/scripts/paths/damsel/damsel_1/damsel_1_encounter.rpy:53
    old "{i}• [[Rescue the Princess.]{/i}"
    new ""

    # game/scripts/paths/damsel/damsel_1/damsel_1_encounter.rpy:118
    old "{i}• ''No? I don't want the world to end.''{/i}"
    new ""

    # game/scripts/paths/damsel/damsel_1/damsel_1_encounter.rpy:118
    old "{i}• ''I have no feelings one way or the other about the world ending.''{/i}"
    new ""

    # game/scripts/paths/damsel/damsel_1/damsel_1_encounter.rpy:118
    old "{i}• ''Honestly, the world sucks. People are a plague and I hope you brought a slow and painful ruin to them all.''{/i}"
    new ""

    # game/scripts/paths/damsel/damsel_1/damsel_1_encounter.rpy:321
    old "{i}• ''I'm the one who makes the decisions here, and I say {b}no{/b}!''{/i}"
    new ""

    # game/scripts/paths/damsel/damsel_1/damsel_1_encounter.rpy:321
    old "{i}• ''If that's what you want to do, let's see what happens.''{/i}"
    new ""

    # game/scripts/paths/damsel/damsel_1/damsel_1_encounter.rpy:478
    old "{i}• (Explore) ''What do you want to do?''{/i}"
    new ""

    # game/scripts/paths/damsel/damsel_1/damsel_1_encounter.rpy:478
    old "{i}• ''We leave. And then we have our whole lives to figure out what we want to do next.''{/i}"
    new ""

    # game/scripts/paths/damsel/damsel_1/damsel_1_encounter.rpy:553
    old "{i}• ''Okay. Clearly something is happening here, and I'm very scared. What if we just... don't do anything? What if we just stay here? Nobody gets hurt, and we just figure out a way to be happy, together.''{/i}"
    new ""

    # game/scripts/paths/damsel/damsel_1/damsel_1_encounter.rpy:553
    old "{i}• (Explore) ''You're just parroting my questions. What do you actually want?''{/i}"
    new ""

    # game/scripts/paths/damsel/damsel_1/damsel_1_encounter.rpy:553
    old "{i}• (Explore) ''I want you to tell me what you want.''{/i}"
    new ""

    # game/scripts/paths/damsel/damsel_1/damsel_1_encounter.rpy:553
    old "{i}• (Explore) ''There must be something you want!''{/i}"
    new ""

    # game/scripts/paths/damsel/damsel_1/damsel_1_encounter.rpy:553
    old "{i}• (Explore) ''But what would make you happy?''{/i}"
    new ""

    # game/scripts/paths/damsel/damsel_1/damsel_1_encounter.rpy:553
    old "{i}• (Explore) ''You have to want something more than just making me happy.''{/i}"
    new ""

    # game/scripts/paths/damsel/damsel_1/damsel_1_encounter.rpy:553
    old "{i}• (Explore) ''But you need your own thing. You just met me. You can't base your entire happiness around me.''{/i}"
    new ""

    # game/scripts/paths/damsel/damsel_1/damsel_1_encounter.rpy:553
    old "{i}• (Explore) ''I want you to make me unhappy.''{/i}"
    new ""

    # game/scripts/paths/damsel/damsel_1/damsel_1_encounter.rpy:553
    old "{i}• (Explore) ''Do you want to end the world?''{/i}"
    new ""

    # game/scripts/paths/damsel/damsel_1/damsel_1_encounter.rpy:553
    old "{i}• ''I just want to leave. We can figure out the rest later.''{/i}"
    new ""

    # game/scripts/paths/damsel/damsel_1/damsel_1_encounter.rpy:553
    old "{i}• ''If you want to leave, then let's leave.''{/i}"
    new ""

    # game/scripts/paths/damsel/damsel_1/damsel_1_encounter.rpy:553
    old "{i}• ''This isn't right. Let's just get out of here.''{/i}"
    new ""

    # game/scripts/paths/damsel/damsel_1/damsel_1_encounter.rpy:553
    old "{i}• ''Something isn't right here. I'm sorry.'' [[Slay the Princess.]{/i}"
    new ""

    # game/scripts/paths/damsel/damsel_1/damsel_1_encounter.rpy:881
    old "{i}• ''I have no feelings about the world ending either way.''{/i}"
    new ""

    # game/scripts/paths/damsel/damsel_1/damsel_1_encounter.rpy:881
    old "{i}• ''Honestly, the world sucks. People are a plague and I hope you bring a slow and painful ruin to them all.''{/i}"
    new ""

    # game/scripts/paths/damsel/damsel_1/damsel_1_encounter.rpy:1163
    old "{i}• (Explore) ''Do you think you can open it?''{/i}"
    new ""

    # game/scripts/paths/damsel/damsel_1/damsel_1_encounter.rpy:1163
    old "{i}• ''Yeah. I think you've got this.''{/i}"
    new ""

    # game/scripts/paths/damsel/damsel_1/damsel_1_encounter.rpy:1163
    old "{i}• ''I think we can open it if we try together.''{/i}"
    new ""

    # game/scripts/paths/damsel/damsel_1/damsel_1_encounter.rpy:1163
    old "{i}• ''I think I've got this.'' [[Open the door by yourself.]{/i}"
    new ""

    # game/scripts/paths/damsel/damsel_1/damsel_1_encounter.rpy:1278
    old "{i}• [[Take the blade and slay the Princess.]{/i}"
    new ""

    # game/scripts/paths/damsel/damsel_1/damsel_1_encounter.rpy:1278
    old "{i}• [[You're not doing that.]{/i}"
    new ""

    # game/scripts/paths/damsel/damsel_1/damsel_1_encounter.rpy:1341
    old "{i}• ''All we need to be happy is each other, what if we just stayed here and built a life together?''{/i}"
    new ""

    # game/scripts/paths/damsel/damsel_1/damsel_1_encounter.rpy:1341
    old "{i}• Stop it with these interruptions. I already made up my mind. We're leaving.{/i}"
    new ""

    # game/scripts/paths/damsel/damsel_1/damsel_1_encounter.rpy:1341
    old "{i}• [[Just ignore them.]{/i}"
    new ""

    # game/scripts/paths/damsel/damsel_1/damsel_1_encounter.rpy:1371
    old "{i}• ''Your nonchalance about the fate of the world has me a bit worried. That's why I want to stay here.''{/i}"
    new ""

    # game/scripts/paths/damsel/damsel_1/damsel_1_encounter.rpy:1371
    old "{i}• ''Trust me. It'll be better for both of us if we stay. We can be happy here. We just have to want it.''{/i}"
    new ""

    # game/scripts/paths/damsel/damsel_1/damsel_1_encounter.rpy:1371
    old "{i}• ''You're right. We're leaving.''{/i}"
    new ""

