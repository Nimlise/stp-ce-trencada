translate catalan strings:

    # game/scripts/paths/witch/witch_1/witch_1_encounter.rpy:63
    old "{i}• (Explore) ''I'm sorry about last time.''{/i}"
    new ""

    # game/scripts/paths/witch/witch_1/witch_1_encounter.rpy:63
    old "{i}• (Explore) ''Look, I made a mistake. We all make mistakes, right? I'm sure you've made mistakes.''{/i}"
    new ""

    # game/scripts/paths/witch/witch_1/witch_1_encounter.rpy:63
    old "{i}• (Explore) ''Don't worry, the blade isn't for you. Or, not for killing you. We've got to get you out somehow, right?''{/i}"
    new ""

    # game/scripts/paths/witch/witch_1/witch_1_encounter.rpy:63
    old "{i}• (Explore) ''I get the sense that you're not happy with me.''{/i}"
    new ""

    # game/scripts/paths/witch/witch_1/witch_1_encounter.rpy:63
    old "{i}• (Explore) ''You scared me, okay? When you started gnawing your arm off, it scared me, so I stabbed you. Things got out of hand.''{/i}"
    new ""

    # game/scripts/paths/witch/witch_1/witch_1_encounter.rpy:63
    old "{i}• (Explore) ''I'm unarmed. That's a gesture of good-will! So why don't we talk it out?''{/i}"
    new ""

    # game/scripts/paths/witch/witch_1/witch_1_encounter.rpy:63
    old "{i}• (Explore) ''We both died last time. Can't bygones be bygones?''{/i}"
    new ""

    # game/scripts/paths/witch/witch_1/witch_1_encounter.rpy:63
    old "{i}• (Explore) ''I didn't do shit to you last time. You're the one who locked me away until I died.''{/i}"
    new ""

    # game/scripts/paths/witch/witch_1/witch_1_encounter.rpy:63
    old "{i}• (Explore) ''I died last time. You didn't. If anyone here shouldn't be trusted, it's you!''{/i}"
    new ""

    # game/scripts/paths/witch/witch_1/witch_1_encounter.rpy:63
    old "{i}• (Explore) ''Look, I know, I know. Things got messy last time. But I think there's something bigger than both of us at work. We should team up.''{/i}"
    new ""

    # game/scripts/paths/witch/witch_1/witch_1_encounter.rpy:63
    old "{i}• (Explore) ''So we're at an impasse. Neither of us are gonna get anywhere if we can't trust each other. Unless you want to fight. But I don't want to fight.''{/i}"
    new ""

    # game/scripts/paths/witch/witch_1/witch_1_encounter.rpy:63
    old "{i}• (Explore) ''I didn't bring my blade down, remember? How am I supposed to get you out of those chains?''{/i}"
    new ""

    # game/scripts/paths/witch/witch_1/witch_1_encounter.rpy:63
    old "{i}• (Explore) ''I guess I'll cut you out of here.''{/i}"
    new ""

    # game/scripts/paths/witch/witch_1/witch_1_encounter.rpy:63
    old "{i}• (Explore) ''Can't you get out of those on your own? Those chains didn't stop you last time.''{/i}"
    new ""

    # game/scripts/paths/witch/witch_1/witch_1_encounter.rpy:63
    old "{i}• (Explore) ''If you could have gotten out this whole time, what do you even need me for? The cabin isn't locked.''{/i}"
    new ""

    # game/scripts/paths/witch/witch_1/witch_1_encounter.rpy:63
    old "{i}• (Explore) ''Why do I have a nagging feeling you're going to stab me in the back if I help you out of here?''{/i}"
    new ""

    # game/scripts/paths/witch/witch_1/witch_1_encounter.rpy:63
    old "{i}• ''Okay. Let's leave.'' [[Leave with the Princess.]{/i}"
    new ""

    # game/scripts/paths/witch/witch_1/witch_1_encounter.rpy:63
    old "{i}• ''I don't want to hurt you, but clearly there's some broken trust. Take this as a gesture of my goodwill.'' [[Give her the blade.]{/i}"
    new ""

    # game/scripts/paths/witch/witch_1/witch_1_encounter.rpy:63
    old "{i}• ''I don't trust you. Not enough to free you, and definitely not enough to get close to you. I'm leaving. Bye.'' [[Leave her in the basement.]{/i}"
    new ""

    # game/scripts/paths/witch/witch_1/witch_1_encounter.rpy:63
    old "{i}• ''I'd like to be straightforward with my intentions. I didn't care for how you treated me last time, and I think you might be a danger to the world. I'm going to attack you now.'' [[Slay the Princess.]{/i}"
    new ""

    # game/scripts/paths/witch/witch_1/witch_1_encounter.rpy:339
    old "{i}• This isn't a democracy. We're giving her the blade. [[Give her the blade.]{/i}"
    new ""

    # game/scripts/paths/witch/witch_1/witch_1_encounter.rpy:339
    old "{i}• Haha. Yeah nevermind that was such a silly idea. I'm not going to give her the blade. She clearly hates us. [[Don't do it!]{/i}"
    new ""

    # game/scripts/paths/witch/witch_1/witch_1_encounter.rpy:423
    old "{i}• ''That's up to you. It's why I gave you the blade. I chose last time, and I regret it. So now it's your time to choose.''{/i}"
    new ""

    # game/scripts/paths/witch/witch_1/witch_1_encounter.rpy:423
    old "{i}• ''We're both scared and we're both hurting. If one of us doesn't make a change, we'll probably kill each other forever. Do you want that? I don't. We can be better than this.''{/i}"
    new ""

    # game/scripts/paths/witch/witch_1/witch_1_encounter.rpy:423
    old "{i}• ''You're beautiful. I want to {b}actually{/b} save you, and this feels like the only way to do it.''{/i}"
    new ""

    # game/scripts/paths/witch/witch_1/witch_1_encounter.rpy:423
    old "{i}• ''If you're like someone I know, you're probably going to kill me.''{/i}"
    new ""

    # game/scripts/paths/witch/witch_1/witch_1_encounter.rpy:859
    old "{i}• (Explore) ''What about you? They'll crush you just as easily as they'll crush me.''{/i}"
    new ""

    # game/scripts/paths/witch/witch_1/witch_1_encounter.rpy:859
    old "{i}• (Explore) ''Make them stop! You can make them stop, right?''{/i}"
    new ""

    # game/scripts/paths/witch/witch_1/witch_1_encounter.rpy:859
    old "{i}• (Explore) ''Why, though? Why are you doing this?''{/i}"
    new ""

    # game/scripts/paths/witch/witch_1/witch_1_encounter.rpy:859
    old "{i}• (Explore) ''Come on! They're pressing in on me. They're pressing in on you! This sucks!''{/i}"
    new ""

    # game/scripts/paths/witch/witch_1/witch_1_encounter.rpy:859
    old "{i}• (Explore) ''We're not animals! We're people. We can work this out. We can make things better.''{/i}"
    new ""

    # game/scripts/paths/witch/witch_1/witch_1_encounter.rpy:859
    old "{i}• (Explore) ''I take it all back! I can help you get out of here! You and I can work together! We can be friends. I'm sorry!''{/i}"
    new ""

    # game/scripts/paths/witch/witch_1/witch_1_encounter.rpy:859
    old "{i}• [[Give up, and await your death.]{/i}"
    new ""

    # game/scripts/paths/witch/witch_1/witch_1_encounter.rpy:859
    old "{i}• [[Go out fighting.]{/i}"
    new ""

    # game/scripts/paths/witch/witch_1/witch_1_encounter.rpy:1090
    old "{i}• (Explore) ''You first.''{/i}"
    new ""

    # game/scripts/paths/witch/witch_1/witch_1_encounter.rpy:1090
    old "{i}• (Explore) ''Clearly, there's some broken trust here. What if I gave you this?'' [[Give her the blade.]{/i}"
    new ""

    # game/scripts/paths/witch/witch_1/witch_1_encounter.rpy:1090
    old "{i}• (Explore) ''You're the one who said you can't leave here without me, which means I hold all the cards. Either you go first, or we stay here. Up to you!''{/i}"
    new ""

    # game/scripts/paths/witch/witch_1/witch_1_encounter.rpy:1168
    old "{i}• (Explore) I'm not stabbing her in the back.{/i}"
    new ""

    # game/scripts/paths/witch/witch_1/witch_1_encounter.rpy:1168
    old "{i}• I said I'm not stabbing her in the back. And I make the choices here.{/i}"
    new ""

    # game/scripts/paths/witch/witch_1/witch_1_encounter.rpy:1168
    old "{i}• Wow, that's an amazing idea that I totally never saw coming, thanks for looking out for us! [[Stab her in the back.]{/i}"
    new ""

    # game/scripts/paths/witch/witch_1/witch_1_encounter.rpy:1168
    old "{i}• I am not going to praise you, but I am going to [[Stab her in the back.]{/i}"
    new ""

    # game/scripts/paths/witch/witch_1/witch_1_encounter.rpy:1168
    old "{i}• Ugh. Fine. [[Stab her in the back.]{/i}"
    new ""

    # game/scripts/paths/witch/witch_1/witch_1_encounter.rpy:1357
    old "{i}• (Explore) Try the door.{/i}"
    new ""

    # game/scripts/paths/witch/witch_1/witch_1_encounter.rpy:1357
    old "{i}• (Explore) Force the door.{/i}"
    new ""

    # game/scripts/paths/witch/witch_1/witch_1_encounter.rpy:1357
    old "{i}• (Explore) ''Okay. Fine. You got me. Very funny. Can you let me out now?''{/i}"
    new ""

    # game/scripts/paths/witch/witch_1/witch_1_encounter.rpy:1357
    old "{i}• (Explore) ''Please just let me out, I promise I won't be mad.''{/i}"
    new ""

    # game/scripts/paths/witch/witch_1/witch_1_encounter.rpy:1357
    old "{i}• (Explore) ''I thought you needed me to get out.''{/i}"
    new ""

    # game/scripts/paths/witch/witch_1/witch_1_encounter.rpy:1357
    old "{i}• Okay. What happens now? I'm stuck here.{/i}"
    new ""

    # game/scripts/paths/witch/witch_1/witch_1_encounter.rpy:1579
    old "{i}• ''I can't get up. You broke my back.''{/i}"
    new ""

    # game/scripts/paths/witch/witch_1/witch_1_encounter.rpy:1579
    old "{i}• ''What the hell was that for? I was trying to help you out of here!''{/i}"
    new ""

    # game/scripts/paths/witch/witch_1/witch_1_encounter.rpy:1579
    old "{i}• ''Damn. I thought I had you there''{/i}"
    new ""

    # game/scripts/paths/witch/witch_1/witch_1_encounter.rpy:1579
    old "{i}• ''We were never going to get up those stairs, were we?''{/i}"
    new ""

    # game/scripts/paths/witch/witch_1/witch_1_encounter.rpy:1579
    old "{i}• ''We could have gotten out of here if we'd just trusted each other.''{/i}"
    new ""

    # game/scripts/paths/witch/witch_1/witch_1_encounter.rpy:1917
    old "{i}• (Explore) ''Come on! They're pressing in on me. They're probably pressing in on you too! I'm only assuming that because I can't see you but it sure sounds like they are!''{/i}"
    new ""

    # game/scripts/paths/witch/witch_1/witch_1_encounter.rpy:1917
    old "{i}• (Explore) ''I take it all back! I can help you get out of here! You and I can work together! We can be friends.''{/i}"
    new ""

