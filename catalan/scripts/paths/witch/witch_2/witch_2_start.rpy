    old "{color=#FFFFFF00}Chapter 3. The Thorn.{/color}"
    new ""

    # game/scripts/paths/witch/witch_2/witch_2_start.rpy:118
    old "{i}• (Explore) This place is different. It keeps changing.{/i}"
    new ""

    # game/scripts/paths/witch/witch_2/witch_2_start.rpy:118
    old "{i}• (Explore) We're going to free her.{/i}"
    new ""

    # game/scripts/paths/witch/witch_2/witch_2_start.rpy:118
    old "{i}• (Explore) We're even now. I'm sure she understands that. But we can see what she has to say for herself when we get to the cabin.{/i}"
    new ""

    # game/scripts/paths/witch/witch_2/witch_2_start.rpy:118
    old "{i}• (Explore) I hope you don't think I'm planning on freeing her after she stabbed me in the heart.{/i}"
    new ""

    # game/scripts/paths/witch/witch_2/witch_2_start.rpy:118
    old "{i}• (Explore) Screw the cabin, what happens if we just leave?{/i}"
    new ""

    # game/scripts/paths/witch/witch_2/witch_2_start.rpy:118
    old "{i}• (Explore) You sure seem to be taking the whole 'looping' thing in stride.{/i}"
    new ""

    # game/scripts/paths/witch/witch_2/witch_2_start.rpy:351
    old "{i}• (Explore) How do we even get down there? The only thing I see is that mirror.{/i}"
    new ""

    # game/scripts/paths/witch/witch_2/witch_2_start.rpy:501
    old "{i}• (Explore) ''I want to figure out a way out of here. For good.''{/i}"
    new ""

    # game/scripts/paths/witch/witch_2/witch_2_start.rpy:501
    old "{i}• (Explore) ''I don't know what I want. I never really chose to come here.''{/i}"
    new ""

    # game/scripts/paths/witch/witch_2/witch_2_start.rpy:501
    old "{i}• (Explore) ''I want to free you. I mean it.''{/i}"
    new ""

    # game/scripts/paths/witch/witch_2/witch_2_start.rpy:501
    old "{i}• (Explore) ''I just want to talk. Really talk.''{/i}"
    new ""

    # game/scripts/paths/witch/witch_2/witch_2_start.rpy:617
    old "{i}• (Explore) ''Yeah. I'm here to laugh. What did you think would happen after you killed me? Did you think I wouldn't hold it against you?''{/i}"
    new ""

    # game/scripts/paths/witch/witch_2/witch_2_start.rpy:617
    old "{i}• (Explore) ''I'm not here to laugh. I'm here to free you. If you'll let me.''{/i}"
    new ""

    # game/scripts/paths/witch/witch_2/witch_2_start.rpy:617
    old "{i}• (Explore) ''You're not the only one who yearns for freedom. I'm as trapped as you are. I think we need to leave together.''{/i}"
    new ""

    # game/scripts/paths/witch/witch_2/witch_2_start.rpy:617
    old "{i}• (Explore) ''I can cut you free. But you'll have to give me the blade.''{/i}"
    new ""

    # game/scripts/paths/witch/witch_2/witch_2_start.rpy:617
    old "{i}• (Explore) ''Is there nothing I can say to change your mind?''{/i}"
    new ""

    # game/scripts/paths/witch/witch_2/witch_2_start.rpy:617
    old "{i}• (Explore) ''Then maybe it's past time for either of us to say anything. All that counts is action'' [[Reach for the blade.]{/i}"
    new ""

    # game/scripts/paths/witch/witch_2/witch_2_start.rpy:617
    old "{i}• (Explore) ''Can I take the blade now?''{/i}"
    new ""

    # game/scripts/paths/witch/witch_2/witch_2_start.rpy:617
    old "{i}• (Explore) [[Reach for the blade.]{/i}"
    new ""

    # game/scripts/paths/witch/witch_2/witch_2_start.rpy:617
    old "{i}• ''You're in a prison of your own making. I broke our cycle of violence. If you still want to wallow in it, be my guest.'' [[Turn and leave.]{/i}"
    new ""

    # game/scripts/paths/witch/witch_2/witch_2_start.rpy:617
    old "{i}• ''I guess I don't have anything left to say to you.'' [[Turn and leave.]{/i}"
    new ""

    # game/scripts/paths/witch/witch_2/witch_2_start.rpy:617
    old "{i}• ''Fine. If you're going to be like that, I'm going to leave. Have a nice life.'' [[Turn and leave.]{/i}"
    new ""

    # game/scripts/paths/witch/witch_2/witch_2_start.rpy:617
    old "{i}• [[Cut her free.]{/i}"
    new ""

    # game/scripts/paths/witch/witch_2/witch_2_start.rpy:617
    old "{i}• ''I just wanted my blade back. You're on your own.'' [[Turn and leave.]{/i}"
    new ""

    # game/scripts/paths/witch/witch_2/witch_2_start.rpy:1060
    old "{i}• ''Of course I did.''{/i}"
    new ""

    # game/scripts/paths/witch/witch_2/witch_2_start.rpy:1060
    old "{i}• ''I just really hate the people who put us here.''{/i}"
    new ""

