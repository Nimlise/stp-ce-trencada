    old "{i}• ''Okay. Let's say I want to stop her. What do I do? I feel like I can't do much of anything right now.''{/i}"
    new ""

    # game/scripts/paths/_joint/wild/wild_start.rpy:251
    old "{i}• [[Passively exist.]{/i}"
    new ""

    # game/scripts/paths/_joint/wild/wild_start.rpy:251
    old "{i}• ''Why should anyone do anything right now? This is fine! I like being this.''{/i}"
    new ""

    # game/scripts/paths/_joint/wild/wild_start.rpy:251
    old "{i}• ''Why are you being nice to me? Don't you hate me? Don't we sort of hate each other?''{/i}"
    new ""

    # game/scripts/paths/_joint/wild/wild_start.rpy:251
    old "{i}• ''Why are you being nice to me? Aren't you a monster? Didn't you eat me?''{/i}"
    new ""

    # game/scripts/paths/_joint/wild/wild_start.rpy:251
    old "{i}• ''He's right! I don't want a passive existence. I want things to do. So someone give me some options!''{/i}"
    new ""

    # game/scripts/paths/_joint/wild/wild_start.rpy:251
    old "{i}• ''I can feel the pressure of the outside pushing in on us. What are we supposed to do about it?''{/i}"
    new ""

    # game/scripts/paths/_joint/wild/wild_start.rpy:251
    old "{i}• ''This is how we're supposed to be. But what do we do now?''{/i}"
    new ""

    # game/scripts/paths/_joint/wild/wild_start.rpy:251
    old "{i}• ''Whatever we are right now is an abomination, and I want out!''{/i}"
    new ""

    # game/scripts/paths/_joint/wild/wild_start.rpy:251
    old "{i}• ''I don't like this. I'm supposed to be me, and you're supposed to be something that isn't me.''{/i}"
    new ""

