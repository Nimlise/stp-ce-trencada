translate catalan strings:

    # game/scripts/paths/spectre/spectre_1/spectre_hostile.rpy:5
    old "{i}• (Explore) ''If I knew I'd have to talk to you again, I wouldn't have slain you.''{/i}"
    new ""

    # game/scripts/paths/spectre/spectre_1/spectre_hostile.rpy:5
    old "{i}• (Explore) ''What if I buried your bones outside?''{/i}"
    new ""

    # game/scripts/paths/spectre/spectre_1/spectre_hostile.rpy:5
    old "{i}• (Explore) ''Of course I attacked you. You're supposed to end the world. That's why I killed you last time, too.''{/i}"
    new ""

    # game/scripts/paths/spectre/spectre_1/spectre_hostile.rpy:5
    old "{i}• [[Smash her bones.]{/i}"
    new ""

    # game/scripts/paths/spectre/spectre_1/spectre_hostile.rpy:5
    old "{i}• [[Slay the Princess, harder.]{/i}"
    new ""

    # game/scripts/paths/spectre/spectre_1/spectre_hostile.rpy:5
    old "{i}• [[Grab the Princess, but try harder.]{/i}"
    new ""

    # game/scripts/paths/spectre/spectre_1/spectre_hostile.rpy:5
    old "{i}• ''Fine. If I can't hurt you, then there really isn't anything for me to do here. I guess I'll get going.'' [[Leave her in the basement.]{/i}"
    new ""

    # game/scripts/paths/spectre/spectre_1/spectre_hostile.rpy:5
    old "{i}• ''Right. I don't think there's much more for us to talk about. I'm going to get my blade now, and then the two of us can fight.'' [[Retrieve the blade.]{/i}"
    new ""

    # game/scripts/paths/spectre/spectre_1/spectre_hostile.rpy:38
    old "{i}• (Explore) ''Well? Were you going to end the world? Would you end it, if you could?''{/i}"
    new ""

    # game/scripts/paths/spectre/spectre_1/spectre_hostile.rpy:38
    old "{i}• (Explore) ''Things end. Things have to end. This sentence just ended.''{/i}"
    new ""

    # game/scripts/paths/spectre/spectre_1/spectre_hostile.rpy:38
    old "{i}• (Explore) ''It's a yes or no question. Do you want to end the world?''{/i}"
    new ""

    # game/scripts/paths/spectre/spectre_1/spectre_hostile.rpy:126
    old "{i}• ''Before I agree to anything, we need to talk about what happens after you leave. I was told you'd end the world.''{/i}"
    new ""

    # game/scripts/paths/spectre/spectre_1/spectre_hostile.rpy:126
    old "{i}• ''No complaints here. Do it.'' [[Let the Princess possess you.]{/i}"
    new ""

    # game/scripts/paths/spectre/spectre_1/spectre_hostile.rpy:126
    old "{i}• ''The answer is no.''{/i}"
    new ""

