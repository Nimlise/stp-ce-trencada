translate catalan strings:

    # game/scripts/paths/razor/razor_2/razor_2_nexus.rpy:86
    old "{i}• We're going to fight her again, and we're going to have a stiff upper lip about it. She can't hurt us if we don't let ourselves feel it.{/i}"
    new ""

    # game/scripts/paths/razor/razor_2/razor_2_nexus.rpy:86
    old "{i}• We're fighting her, obviously.{/i}"
    new ""

    # game/scripts/paths/razor/razor_2/razor_2_nexus.rpy:86
    old "{i}• We're going to appeal to her authority. Puff her up a bit. There's no reason we can't talk this out.{/i}"
    new ""

    # game/scripts/paths/razor/razor_2/razor_2_nexus.rpy:86
    old "{i}• We're going to unconditionally surrender.{/i}"
    new ""

    # game/scripts/paths/razor/razor_2/razor_2_nexus.rpy:86
    old "{i}• Oh, that's easy. I'm going to try flirting with her.{/i}"
    new ""

    # game/scripts/paths/razor/razor_2/razor_2_nexus.rpy:86
    old "{i}• She has swords for arms and we don't. We're panicking!{/i}"
    new ""

    # game/scripts/paths/razor/razor_2/razor_2_nexus.rpy:86
    old "{i}• We're going to fight her, and we're going to have a stiff upper lip about it. She can't hurt us if we don't let ourselves feel it.{/i}"
    new ""

    # game/scripts/paths/razor/razor_2/razor_2_nexus.rpy:86
    old "{i}• She wins by killing us, right? So let's beat her to it!{/i}"
    new ""

    # game/scripts/paths/razor/razor_2/razor_2_nexus.rpy:86
    old "{i}• [[All of these ideas suck. Think up something better.]{/i}"
    new ""

    # game/scripts/paths/razor/razor_2/razor_2_nexus.rpy:113
    old "{i}• Cheer up! Maybe we'll win!{/i}"
    new ""

    # game/scripts/paths/razor/razor_2/razor_2_nexus.rpy:113
    old "{i}• See, but that's the brilliance of it all. She doesn't think we have it in us to win.{/i}"
    new ""

    # game/scripts/paths/razor/razor_2/razor_2_nexus.rpy:113
    old "{i}• I'm done explaining myself. I'm going to stab her now.{/i}"
    new ""

    # game/scripts/paths/razor/razor_2/razor_2_nexus.rpy:243
    old "{i}• ''You know, I'm a big fan of winners, and you've got 'winner' written all over you. How about we stop fighting and team up? I'll even let you be in charge!''{/i}"
    new ""

    # game/scripts/paths/razor/razor_2/razor_2_nexus.rpy:243
    old "{i}• ''Look, both of us are stuck here against our will. What if we joined forces?''{/i}"
    new ""

    # game/scripts/paths/razor/razor_2/razor_2_nexus.rpy:243
    old "{i}• ''Has anyone ever told you how good you are at stabbing things?''{/i}"
    new ""

    # game/scripts/paths/razor/razor_2/razor_2_nexus.rpy:275
    old "{i}• ''Yes! Yes, I am trying to get on your good side. Did it work?''{/i}"
    new ""

    # game/scripts/paths/razor/razor_2/razor_2_nexus.rpy:275
    old "{i}• ''Yes! Yes, I am bored of you stabbing me. Can you stop stabbing me now?''{/i}"
    new ""

    # game/scripts/paths/razor/razor_2/razor_2_nexus.rpy:275
    old "{i}• ''Psht. What? Me? Fluffing you up? I'm just stating facts.''{/i}"
    new ""

    # game/scripts/paths/razor/razor_2/razor_2_nexus.rpy:429
    old "{i}• ''I give up. I'll do anything, just please don't stab me!''{/i}"
    new ""

    # game/scripts/paths/razor/razor_2/razor_2_nexus.rpy:429
    old "{i}• [[Silently throw your hands in the air.]{/i}"
    new ""

    # game/scripts/paths/razor/razor_2/razor_2_nexus.rpy:512
    old "{i}• ''I know you want to kill me, but has anyone ever told you how gorgeous you are?''{/i}"
    new ""

    # game/scripts/paths/razor/razor_2/razor_2_nexus.rpy:512
    old "{i}• ''I just feel like I really get you. I like you. Romantically, even. Maybe we can hash this out over a date.''{/i}"
    new ""

    # game/scripts/paths/razor/razor_2/razor_2_nexus.rpy:512
    old "{i}• ''How about you buy me dinner before impaling me to death?''{/i}"
    new ""

    # game/scripts/paths/razor/razor_2/razor_2_nexus.rpy:512
    old "{i}• [[Give her {b}The Look{/b}.]{/i}"
    new ""

    # game/scripts/paths/razor/razor_2/razor_2_nexus.rpy:709
    old "{i}• ''Do your worst! I bet you can't even hurt me.''{/i}"
    new ""

    # game/scripts/paths/razor/razor_2/razor_2_nexus.rpy:709
    old "{i}• [[Wait for her to come to you.]{/i}"
    new ""

    # game/scripts/paths/razor/razor_2/razor_2_nexus.rpy:982
    old "{i}• We're going to let her stab us, and we're going to have a stiff upper lip about it. She can't hurt us if we don't let ourselves feel it.{/i}"
    new ""

    # game/scripts/paths/razor/razor_2/razor_2_nexus.rpy:1535
    old "{i}• I'm going to go with not letting her stab us. We can dodge, right?{/i}"
    new ""

    # game/scripts/paths/razor/razor_2/razor_2_nexus.rpy:1553
    old "{i}• Maybe we'll win!{/i}"
    new ""

    # game/scripts/paths/razor/razor_2/razor_2_nexus.rpy:1553
    old "{i}• See, but that's the brilliance of it all. She won't see it coming.{/i}"
    new ""

    # game/scripts/paths/razor/razor_2/razor_2_nexus.rpy:1553
    old "{i}• I'm done explaining myself. I'm going to punch her now.{/i}"
    new ""

    # game/scripts/paths/razor/razor_2/razor_2_nexus.rpy:1684
    old "{i}• ''Yes! Yes I am. Did it work?''{/i}"
    new ""

    # game/scripts/paths/razor/razor_2/razor_2_nexus.rpy:1684
    old "{i}• ''Psht. What? Me? I'm just stating facts.''{/i}"
    new ""

    # game/scripts/paths/razor/razor_2/razor_2_nexus.rpy:2078
    old "{i}• [[Silently let her stab you.]{/i}"
    new ""

