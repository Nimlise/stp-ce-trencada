translate catalan strings:

    # game/scripts/paths/razor/razor_1/razor_1_basement.rpy:111
    old "{i}• (Explore) ''Prove it then. Prove that you don't have a knife.''{/i}"
    new ""

    # game/scripts/paths/razor/razor_1/razor_1_basement.rpy:111
    old "{i}• (Explore) ''But what if you're just hiding it somewhere secret?''{/i}"
    new ""

    # game/scripts/paths/razor/razor_1/razor_1_basement.rpy:111
    old "{i}• (Explore) ''If I come close to you, you're just going to stab me, aren't you?''{/i}"
    new ""

    # game/scripts/paths/razor/razor_1/razor_1_basement.rpy:111
    old "{i}• (Explore) ''Do you remember what happened last time?''{/i}"
    new ""

    # game/scripts/paths/razor/razor_1/razor_1_basement.rpy:111
    old "{i}• (Explore) ''But that's exactly what happened! So you do remember it.''{/i}"
    new ""

    # game/scripts/paths/razor/razor_1/razor_1_basement.rpy:111
    old "{i}• (Explore) ''I know you have a knife. I'll let you out of here if you drop it.''{/i}"
    new ""

    # game/scripts/paths/razor/razor_1/razor_1_basement.rpy:111
    old "{i}• (Explore) ''I'd like to trust you, but you're being so suspicious right now!''{/i}"
    new ""

    # game/scripts/paths/razor/razor_1/razor_1_basement.rpy:111
    old "{i}• (Explore) ''Can we just talk things through?''{/i}"
    new ""

    # game/scripts/paths/razor/razor_1/razor_1_basement.rpy:111
    old "{i}• (Explore) ''I don't have the key.''{/i}"
    new ""

    # game/scripts/paths/razor/razor_1/razor_1_basement.rpy:111
    old "{i}• (Explore) ''I don't have a weapon. Isn't that a sign of good will?''{/i}"
    new ""

    # game/scripts/paths/razor/razor_1/razor_1_basement.rpy:111
    old "{i}• (Explore) ''We killed each other last time. I'd rather not do that again.''{/i}"
    new ""

    # game/scripts/paths/razor/razor_1/razor_1_basement.rpy:111
    old "{i}• (Explore) ''Look, I know that you're mad at me but I think we both just need to let bygones be bygones.''{/i}"
    new ""

    # game/scripts/paths/razor/razor_1/razor_1_basement.rpy:111
    old "{i}• (Explore) ''What happened after you died last time?''{/i}"
    new ""

    # game/scripts/paths/razor/razor_1/razor_1_basement.rpy:111
    old "{i}• (Explore) ''What if we're both honest with each other? I was sent here to stop you from ending the world, and you slashed my throat last time.''{/i}"
    new ""

    # game/scripts/paths/razor/razor_1/razor_1_basement.rpy:111
    old "{i}• (Explore) ''What if we're both honest with each other? I was sent here to stop you from ending the world, and you killed me last time after coming back from being stabbed in the heart.''{/i}"
    new ""

    # game/scripts/paths/razor/razor_1/razor_1_basement.rpy:111
    old "{i}• (Explore) ''Nobody has to die.''{/i}"
    new ""

    # game/scripts/paths/razor/razor_1/razor_1_basement.rpy:111
    old "{i}• (Explore) ''Okay. What are you going to do if I let you out?''{/i}"
    new ""

    # game/scripts/paths/razor/razor_1/razor_1_basement.rpy:111
    old "{i}• (Explore) ''Activities like stabbing or cutting or murdering?''{/i}"
    new ""

    # game/scripts/paths/razor/razor_1/razor_1_basement.rpy:111
    old "{i}• ''Okay, fine. I'm coming closer to free you. You'd better not try anything.'' [[Approach the Princess.]{/i}"
    new ""

    # game/scripts/paths/razor/razor_1/razor_1_basement.rpy:111
    old "{i}• ''Yeah. I'm not trusting this. Bye!'' [[Turn and leave.]{/i}"
    new ""

    # game/scripts/paths/razor/razor_1/razor_1_basement.rpy:111
    old "{i}• ''I'll be right back. I left something upstairs.'' [[Go retrieve the knife upstairs.]{/i}"
    new ""

    # game/scripts/paths/razor/razor_1/razor_1_basement.rpy:111
    old "{i}• ''Screw it.'' [[Slay the Princess.]{/i}"
    new ""

