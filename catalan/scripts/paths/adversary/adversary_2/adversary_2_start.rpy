    old "{i}• (Explore) You never mention the mirror.{/i}"
    new ""

    # game/scripts/paths/adversary/adversary_2/adversary_2_start.rpy:302
    old "{i}• (Explore) That damn mirror's back.{/i}"
    new ""

    # game/scripts/paths/adversary/adversary_2/adversary_2_start.rpy:302
    old "{i}• (Explore) But there's no way forward. There's a mirror at the end of the room and that's it.{/i}"
    new ""

    # game/scripts/paths/adversary/adversary_2/adversary_2_start.rpy:490
    old "{i}• (Explore) ''If you want a fight then how about you come and get one?''{/i}"
    new ""

    # game/scripts/paths/adversary/adversary_2/adversary_2_start.rpy:490
    old "{i}• (Explore) ''I know you can get out of there on your own.''{/i}"
    new ""

    # game/scripts/paths/adversary/adversary_2/adversary_2_start.rpy:490
    old "{i}• (Explore) ''Are you sure you still want to fight?''{/i}"
    new ""

    # game/scripts/paths/adversary/adversary_2/adversary_2_start.rpy:490
    old "{i}• [[Continue to the basement landing.]{/i}"
    new ""

    # game/scripts/paths/adversary/adversary_2/adversary_2_start.rpy:673
    old "{i}• (Explore) ''Let's talk a bit first. We can always fight when we're done, but I have questions. I want to know what happened after you killed me.''{/i}"
    new ""

    # game/scripts/paths/adversary/adversary_2/adversary_2_start.rpy:673
    old "{i}• (Explore) ''Not down here. If you want me, you'll have to come and get me.''{/i}"
    new ""

    # game/scripts/paths/adversary/adversary_2/adversary_2_start.rpy:673
    old "{i}• (Explore) ''If you want a good fight, if you {i}really{/i} want to see me at my best, we need somewhere with more space.''{/i}"
    new ""

    # game/scripts/paths/adversary/adversary_2/adversary_2_start.rpy:673
    old "{i}• (Explore) ''Why don't you want to be free? Why do you insist on fighting me to the death down here in the dark?''{/i}"
    new ""

    # game/scripts/paths/adversary/adversary_2/adversary_2_start.rpy:673
    old "{i}• (Explore) ''I'm not fighting you.''{/i}"
    new ""

    # game/scripts/paths/adversary/adversary_2/adversary_2_start.rpy:673
    old "{i}• [[Step closer, stopping just outside her chains.]{/i}"
    new ""

    # game/scripts/paths/adversary/adversary_2/adversary_2_start.rpy:963
    old "{i}• [[It's too late. Run for the door.]{/i}"
    new ""

    # game/scripts/paths/adversary/adversary_2/adversary_2_start.rpy:1270
    old "{i}• [[Free her.]{/i}"
    new ""

    # game/scripts/paths/adversary/adversary_2/adversary_2_start.rpy:1338
    old "{i}• ''It's freedom.''{/i}"
    new ""

    # game/scripts/paths/adversary/adversary_2/adversary_2_start.rpy:1338
    old "{i}• ''Don't you get it? Everything you've known down there has been a lie. Whatever we find out here is the truth. It's the only way for us to be free.''{/i}"
    new ""

    # game/scripts/paths/adversary/adversary_2/adversary_2_start.rpy:1338
    old "{i}• ''I don't know. But I was hoping we could find out together.''{/i}"
    new ""

    # game/scripts/paths/adversary/adversary_2/adversary_2_start.rpy:1338
    old "{i}• ''What do you mean, 'this doesn't feel right?'''{/i}"
    new ""

    # game/scripts/paths/adversary/adversary_2/adversary_2_start.rpy:1439
    old "{i}• ''Are you sure you want to do this? You're free now, and out here I have the upper hand. But we don't have to fight.''{/i}"
    new ""

    # game/scripts/paths/adversary/adversary_2/adversary_2_start.rpy:1439
    old "{i}• (Explore) ''You've fallen right into my trap.''{/i}"
